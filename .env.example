# Copy this file to .env.development (or .env.staging / .env.production).
# NEVER commit .env.staging or .env.production.
# EXPO_PUBLIC_* vars are bundled into the JS bundle — do NOT put secrets here.

# Environment discriminator
EXPO_PUBLIC_ENV=development

# Sentry DSN — Phase 2 (optional; app gracefully no-ops when absent)
# EXPO_PUBLIC_SENTRY_DSN=

# BGG developer token — obtained from https://boardgamegeek.com/xmlapi2 after
# registering your application. Optional: the public API works without it,
# but the token raises rate limits and may unlock authenticated endpoints later.
# Store this in .env.development.local (gitignored), NOT in .env.development.
# EXPO_PUBLIC_BGG_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# The shared game profile (rules FAQ) reads BoardGameGeek on the server.
# Set that copy with: firebase functions:secrets:set BGG_API_TOKEN
# Do not put the server token in an EXPO_PUBLIC_ variable.

# Firebase App Check debug UUID for local Android/iOS — register the same value in
# Firebase Console → App Check → Manage debug tokens. Without it, LLM callables
# fail with "Unauthenticated" even when Auth is valid.
# EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Note: Firebase credentials are NOT managed via env vars when using
# @react-native-firebase (native SDK). Add google-services.json (Android)
# and GoogleService-Info.plist (iOS) to the project root in Phase 2.
# Both files are git-ignored.
