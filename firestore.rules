rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles — only the owner can read or write their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Chat threads — owner identified by the userId field on the thread document.
    match /chatThreads/{threadId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;

      // TODO Phase 2: Tighten message rules; consider separating read/write grants.
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // Deny all other reads and writes by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
