rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles + everything nested under the user (games, conversation
    // threads and their messages) — only the owner can read or write their own
    // subtree. Chat lives at users/{uid}/threads/{threadId}/messages.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Shared BoardGameGeek profiles (metadata + rules FAQ). Written only by
    // Cloud Functions via the Admin SDK. Any signed-in player may read them.
    match /bggGames/{bggId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Deny all other reads and writes by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
